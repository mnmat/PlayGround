executable            = run.sh
arguments             = $(eta) $(energy) $(nevents) $(idx) $(root) $(outdir) $(xi) $(generator)
universe              = vanilla
+JobFlavour = "workday"
should_transfer_files = YES
transfer_input_files  = Config.py
getenv                = true
output                = condor/output/create_samples.$(eta).$(energy).out
error                 = condor/error/create_samples.$(eta).$(energy).err
log                   = condor/log/create_samples.$(eta).$(energy).log
MY.XRDCP_CREATE_DIR = True
+DesiredOS = "EL9"
# max_materialize = 20

queue eta, energy, nevents, idx, root, outdir, xi, generator from files.txt

